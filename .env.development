# Development Environment Configuration
# This file is used for local development and testing

# Set to 'mock' to use MockAIService instead of real API
# Set to 'real' to use actual xAI Grok API
AI_MODE=mock

# xAI API Key (only needed if AI_MODE=real)
# XAI_API_KEY=your_xai_api_key_here

# Optional: Override default model
# XAI_MODEL=grok-beta

# Optional: Override default max tokens
# XAI_MAX_TOKENS=4096

# Optional: Override default temperature
# XAI_TEMPERATURE=0.7

# Log level for development
LOG_LEVEL=debug

# Enable verbose error messages
VERBOSE_ERRORS=true
